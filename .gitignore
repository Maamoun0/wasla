/build/
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies

# OS-specific hidden files
.DS_Store
Thumbs.db

# Firebase configuration secrets
google-services.json
GoogleService-Info.plist
firebase-debug.log

