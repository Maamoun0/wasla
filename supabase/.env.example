# Local stack only (supabase start). Copy to supabase/.env, which git ignores.
# Hosted projects: Auth -> Hooks in the dashboard, and `supabase secrets set`.

# Signing secret shared by Auth and send-sms-hook. Generate your own:
#   echo "v1,whsec_$(openssl rand -base64 32)"
SEND_SMS_HOOK_SECRETS=

# Locally the hook talks to a fake Twilio on the host (started by
# supabase/tests/auth/send_sms_hook.local.ts), so nothing is really sent and
# these are not credentials. Use the local-only test number in config.toml
# (+201000000101, code 123456) to sign in by hand.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_local_fake
TWILIO_AUTH_TOKEN=local-fake-token
TWILIO_FROM=+15550000000
TWILIO_API_BASE=http://host.docker.internal:54399
