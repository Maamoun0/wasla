# Edge Function secrets. Copy to supabase/functions/.env for `supabase functions serve`;
# in hosted projects set them with `supabase secrets set`. Never commit real values.

# Payments (Paymob)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Push notifications: Firebase service-account JSON (one line)
FIREBASE_SERVICE_ACCOUNT=

# AI ad review inside create-ad. Model IDs verified on
# https://platform.claude.com/docs/en/about-claude/models/overview (2026-10-26):
# claude-haiku-5-5 is the fast tier for classification; claude-sonnet-5-5 is the
# documented replacement for the retired claude-3-5-sonnet-20241022.
ANTHROPIC_API_KEY=
MODERATION_MODEL_FAST=claude-haiku-5-5
MODERATION_MODEL_DEEP=claude-sonnet-5-5
# Per-model call timeout; on timeout the ad goes to manual review.
MODERATION_TIMEOUT_MS=15000

# SMS for Auth OTPs, through the Send SMS Hook (send-sms-hook).
# Signing secret from Authentication -> Hooks -> Send SMS ("v1,whsec_..."); several
# separated by "|" are all accepted during a rotation.
SEND_SMS_HOOK_SECRETS=
# Provider file in send-sms-hook/providers/. Twilio is the test provider.
SMS_PROVIDER=twilio
# sms (default). whatsapp is reserved; no provider implements it yet.
SMS_CHANNEL=sms
# Auth gives the whole hook 5 s.
SMS_TIMEOUT_MS=4000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number, or leave empty and set TWILIO_MESSAGING_SERVICE_SID.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# KYC: key for HMAC-SHA256 of the national ID (submit-kyc-request). The ID itself
# is never stored, only its last 4 digits and this HMAC. At least 32 characters,
# e.g. `openssl rand -hex 32`. Keep it out of the database and the repository.
# Changing it means new requests no longer match old ones: an ID submitted before
# the change can be submitted again on another account.
KYC_NATIONAL_ID_HMAC_SECRET=

# Only when the functions see an internal SUPABASE_URL (local development):
# the public URL the app uses to build image links.
PUBLIC_SUPABASE_URL=
